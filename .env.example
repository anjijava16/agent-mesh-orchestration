# ---------------------------------------------------------------------------
# Reasoning
#   deterministic  every agent skips its model and calls its own service.py.
#                  The A2A traffic, MCP calls, task lifecycle, interrupt and
#                  database writes are all unchanged. Runs with no keys, in
#                  about a second, for nothing.
#   llm            additionally asks a model for judgement and prose, and
#                  degrades back to deterministic on any failure.
# ---------------------------------------------------------------------------
REFUNDRY_REASONING=deterministic

# ---------------------------------------------------------------------------
# System One  (TypeSafe AI's Jev)
#   auto   use the real SDK when TYPESAFE_API_KEY is set, else the local
#          stand-in. The stand-in is NOT Jev; it implements the same three
#          primitives offline so the architecture can be exercised.
#   sdk    require the real client, and fail loudly if it will not start
#   local  always use the stand-in
# ---------------------------------------------------------------------------
REFUNDRY_JEV=auto
REFUNDRY_JEV_MODEL=jev-latest
# TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
REFUNDRY_AUTO_APPROVAL=1000.00
REFUNDRY_CLAIM_WINDOW_DAYS=30

# Below this calibrated confidence a person is asked, whatever the amount rule
# would have said on its own.
REFUNDRY_CONFIDENCE_FLOOR=0.62

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
REFUNDRY_HOST=127.0.0.1
REFUNDRY_A2A_TIMEOUT=30
REFUNDRY_EXTERNAL_TIMEOUT=60
REFUNDRY_MCP_TIMEOUT=15

# Simulated latency for the seller's agent, which is across a company boundary.
REFUNDRY_SELLER_DELAY=0.4

# Ingestion Service Configuration

# Service
SERVICE_NAME=ingestion
LOG_LEVEL=INFO

# Database
POSTGRES_DSN=postgresql+asyncpg://agentmesh:agentmesh@postgres:5432/agentmesh
POSTGRES_SYNC_DSN=postgresql+psycopg://agentmesh:agentmesh@postgres:5432/agentmesh

# Redis / Celery
REDIS_DSN=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Object Storage
STORAGE_BACKEND=minio
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=agentmesh-uploads
STORAGE_REGION=us-east-1

# Vector Backend (opensearch | mongodb | pinecone)
VECTOR_BACKEND=opensearch

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Agentmesh#2026
OPENSEARCH_USE_SSL=false
OPENSEARCH_DOCUMENTS_INDEX=agentmesh-documents

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=agentmesh
MONGODB_DOCUMENTS_COLLECTION=document_chunks

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=agentmesh-documents

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
OPENAI_API_KEY=

# LiteLLM (alternative embedding routing)
LITELLM_ENABLED=false
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-agentmesh-local

# Chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# Observability
PHOENIX_ENABLED=false
PHOENIX_HOST=phoenix
PHOENIX_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:4317

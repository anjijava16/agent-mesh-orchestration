# MCP Memory Server Configuration

# Server
MCP_SERVER_NAME=memory
MCP_SERVER_PORT=8083
MCP_SERVER_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database
POSTGRES_DSN=postgresql+asyncpg://agentmesh:agentmesh@postgres:5432/agentmesh

# Vector Store
VECTOR_BACKEND=opensearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Agentmesh#2026
OPENSEARCH_USE_SSL=false
OPENSEARCH_MEMORY_INDEX=agentmesh-longterm-memory

# MongoDB (alternative backend)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=agentmesh
MONGODB_MEMORY_COLLECTION=longterm_memory

# Embeddings (for memory vectorization)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
